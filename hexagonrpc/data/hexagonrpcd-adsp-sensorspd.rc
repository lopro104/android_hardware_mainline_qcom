service vendor.hexagonrpcd-adsp-sensorspd /vendor/bin/hexagonrpcd -f /dev/fastrpc-adsp -d adsp -s -R /vendor/etc/hexagonrpcd-root
    class core
    user system
    group system
    # The sensors PD rebuilds its registry; keep it writable under /data
    setenv HEXAGONRPCD_SNS_WRITE_DIR /data/vendor/sensors
